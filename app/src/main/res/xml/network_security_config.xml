<?xml version="1.0" encoding="utf-8"?>
<!--
   Politique réseau de l'app.

   `cleartextTrafficPermitted="false"` interdit tout trafic HTTP en clair, quelle
   que soit la version d'Android. La plateforme applique déjà ce refus par défaut
   depuis l'API 28, mais le `minSdk` de l'app est 26 : sans cette déclaration,
   deux versions du système autoriseraient encore le clair.

   Cohérent avec le socle : l'origine canonique est
   `https://www.180c.fr` (`app/build.gradle.kts`, `API_ORIGIN`), et le client
   HTTP refuse de suivre les redirections. Aucune exception de développement
   n'est déclarée — il n'existe pas d'environnement local à joindre en clair.

   Ancres de confiance : magasin système uniquement. Les certificats installés
   par l'utilisateur sont volontairement écartés, ce qui écarte du même coup
   l'interception par proxy sur appareil compromis.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
